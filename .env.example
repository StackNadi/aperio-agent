# GitHub App Configuration
GITHUB_APP_ID=your_app_id
GITHUB_PRIVATE_KEY=base64_encoded_private_key
GITHUB_WEBHOOK_SECRET=your_webhook_secret
BOT_USERNAME=aperio[bot]

# AI Configuration
AI_BASE_URL=https://your-ai-provider.example.com/v1
AI_API_KEY=your_api_key
AI_MODEL=your_model_name

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Server Configuration
PORT=3000
LOG_LEVEL=info
WEBHOOK_MAX_BODY_BYTES=5000000

# Review Configuration
MAX_COMMENTS=10
SKIP_PATTERNS=*.lock,*.min.js,package-lock.json
AI_REQUEST_TIMEOUT_MS=60000
GITHUB_REQUEST_TIMEOUT_MS=20000

# Reply Configuration
REPLY_ENABLED=true
REPLY_REQUIRE_MENTION=true
REPLY_MAX_PER_PR=5
REPLY_DELAY_SECONDS=30
REPLY_SKIP_BOTS=true
REPLY_ONLY_COLLABORATORS=true

# Circuit Breaker Configuration
CIRCUIT_BREAKER_THRESHOLD=50
CIRCUIT_BREAKER_RESET_MS=30000
CIRCUIT_BREAKER_VOLUME=5
